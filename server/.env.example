# Copy to server/.env (cp server/.env.example server/.env). Every value here is SERVER-ONLY.
# Never commit server/.env. Placeholders only — no real values in this file.

# --- App
# production on the server: no demo accounts are created
NODE_ENV=development
PORT=4000
# public address, e.g. https://www.ustozsat.uz
SITE_URL=

# --- Database. Leave unset to use the built-in local database (server/data/pg).
DATABASE_URL=

# --- Sessions. 48+ random bytes, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Leave unset to generate one automatically (kept in the database).
JWT_SECRET=

# --- First teacher account (used only when the database is empty)
MASTER_LOGIN=
MASTER_PASSWORD=
MASTER_EMAIL=

# --- Google sign-in: public OAuth client ID (no client secret is used)
GOOGLE_CLIENT_ID=

# --- Telegram bot username (the bot token is entered in the teacher panel)
TELEGRAM_BOT=

# --- Video hosting (Bunny Stream)
BUNNY_API_KEY=
BUNNY_LIBRARY_ID=
BUNNY_TOKEN_KEY=

# --- Optional picture / GIF search
GIPHY_API_KEY=
OPENVERSE_TOKEN=

# --- Scheduler secret for /api/cron/drip
CRON_SECRET=
